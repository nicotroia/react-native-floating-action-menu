{
  "name": "react-native-floating-action-menu",
  "version": "2.2.0",
  "description": "A configurable floating action menu for React Native",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "start": "npm run watch",
    "watch": "tsc --watch",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "example": "cd example/ && pnpm install && pnpm start",
    "prepack": "npm run build",
    "prepublish": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicotroia/react-native-floating-action-menu.git"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "react-native",
    "javascript",
    "typescript",
    "ios",
    "android",
    "floating",
    "action",
    "menu",
    "fab",
    "material",
    "design"
  ],
  "author": "Nico Troia",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "bugs": {
    "url": "https://github.com/nicotroia/react-native-floating-action-menu/issues"
  },
  "homepage": "https://github.com/nicotroia/react-native-floating-action-menu#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-react-jsx": "^7.24.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^18.11.9",
    "@types/react": "^18.2.48",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-plugin-root-import": "^6.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.0.1",
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3"
  }
}
